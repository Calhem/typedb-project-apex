# Copy to .env and adjust if needed:  cp .env.example .env
# .env is git-ignored; never commit it.

# TypeDB connection. Apex has its own container on port 1732 (see compose.yaml).
TYPEDB_ADDRESS=127.0.0.1:1732
TYPEDB_USERNAME=admin
# TypeDB CE's built-in default password: acceptable only on this computer, with TypeDB
# reachable from this computer alone (compose.yaml binds it to 127.0.0.1).
TYPEDB_PASSWORD=password

# Which database the app reads. "apex" is the pristine demo data; "apex-demo" is the copy
# used for live demonstration steps (rebuild it with: uv run python -m scripts.reset_demo).
APEX_DATABASE=apex
