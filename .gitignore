# Local settings and secrets. Only the example file is committed.
.env
.env.*
!.env.example

# Python and tool caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Frontend dependencies and build output
web/node_modules/
web/dist/

# Database files and backups never go in git (the seed data in data/seed/ does).
backups/
*.typedb
*.log

# Private notes (TypeDB feedback log, spike scripts)
notes/

# Operating system and editor clutter
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
web/.layout-sample.json
