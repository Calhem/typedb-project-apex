  # ---- risk register ----
  $rk-cma-p2 isa risk, has code "RK-CMA-P2", has name "CMA refers the merger to Phase 2", has description "The issues letter shows the CMA is considering a Phase 2 reference over the enzyme-replacement overlap.", has likelihood "medium", has severity "critical", has risk-status "open", has mitigation "Answer the issues letter fully, prepare a remedy package, and keep a Phase 2 timetable and financing plan ready.";
  risk-ownership (risk-owner: $per-okafor, owned-risk: $rk-cma-p2);
  risk-exposure (risk: $rk-cma-p2, exposed: $cp-cma);
  risk-exposure (risk: $rk-cma-p2, exposed: $ms-completion);
  $rk-helix isa risk, has code "RK-HELIX", has name "Helix waiver lapses before completion", has description "If completion slips past 31 January 2027, Helix's change-of-control call option over the joint venture revives.", has likelihood "medium", has severity "critical", has risk-status "open", has mitigation "Ask Helix for an extension early if the CMA timetable slips beyond mid-December.";
  risk-ownership (risk-owner: $per-okafor, owned-risk: $rk-helix);
  risk-exposure (risk: $rk-helix, exposed: $dl-helix-waiver);
  $rk-longstop isa risk, has code "RK-LONGSTOP", has name "Long-stop date reached before completion", has description "A long CMA review could take completion past 31 March 2027.", has likelihood "low", has severity "high", has risk-status "open", has mitigation "Agree an extension with Atlas in good time and announce it, as the Code requires.";
  risk-ownership (risk-owner: $per-lindqvist, owned-risk: $rk-longstop);
  risk-exposure (risk: $rk-longstop, exposed: $dl-longstop);
  $rk-funds isa risk, has code "RK-FUNDS", has name "Certain-funds period ends before settlement", has description "The lenders' commitment ends on 30 April 2027; settlement must happen before then.", has likelihood "low", has severity "critical", has risk-status "open", has mitigation "Pre-agree an extension mechanism with Albion and Northmere.";
  risk-ownership (risk-owner: $per-adebayo, owned-risk: $rk-funds);
  risk-exposure (risk: $rk-funds, exposed: $dl-funds);
  risk-exposure (risk: $rk-funds, exposed: $ob-settle);
  $rk-gunjump isa risk, has code "RK-GUNJUMP", has name "Integration planning crosses into gun-jumping", has description "Acting as one business, or sharing competitively sensitive information, before clearance would breach merger control rules.", has likelihood "low", has severity "high", has risk-status "mitigating", has mitigation "Clean-team protocol; competition counsel reviews integration exchanges.";
  risk-ownership (risk-owner: $per-reyes, owned-risk: $rk-gunjump);
  risk-exposure (risk: $rk-gunjump, exposed: $ac-int-clean);
  risk-exposure (risk: $rk-gunjump, exposed: $ac-int-day1);
  $rk-ie-consult isa risk, has code "RK-IE-CONSULT", has name "Irish consultation slips past Day 1", has description "The timetable with employee representatives at Atlas Biologics is not yet confirmed.", has likelihood "medium", has severity "medium", has risk-status "open", has mitigation "Agree the timetable with the representatives this week; escalate through the Site Director.";
  risk-ownership (risk-owner: $per-ferreira, owned-risk: $rk-ie-consult);
  risk-exposure (risk: $rk-ie-consult, exposed: $ac-ppl-ireland);
  risk-exposure (risk: $rk-ie-consult, exposed: $hr-consult);
  $rk-interim isa risk, has code "RK-INTERIM", has name "Interim finance arrangements not ready for Day 1", has description "Novacore still needs Atlas's finance calendar and system access to report from Day 1.", has likelihood "medium", has severity "high", has risk-status "open", has mitigation "Access from Atlas by early November; manual reporting for the first month-end as a fallback.";
  risk-ownership (risk-owner: $per-reyes, owned-risk: $rk-interim);
  risk-exposure (risk: $rk-interim, exposed: $ac-int-interim);
  risk-exposure (risk: $rk-interim, exposed: $ms-day1);
  $rk-attrition isa risk, has code "RK-ATTRITION", has name "Key scientists leave before completion", has description "Atlas's pipeline depends on a small number of senior scientists.", has likelihood "medium", has severity "high", has risk-status "mitigating", has mitigation "Retention awards announced with the deal; monthly check-ins with each award holder.";
  risk-ownership (risk-owner: $per-ferreira, owned-risk: $rk-attrition);
  risk-exposure (risk: $rk-attrition, exposed: $cv-retention);
  risk-exposure (risk: $rk-attrition, exposed: $ac-ppl-retain);
  $rk-leak isa risk, has code "RK-LEAK", has name "Market leak before the firm offer", has description "A leak before 14 July would have forced an early announcement under the Takeover Code.", has likelihood "low", has severity "high", has risk-status "closed", has mitigation "Insider lists, code names and a holding statement. Closed at announcement.";
  risk-ownership (risk-owner: $per-whitfield, owned-risk: $rk-leak);
  risk-exposure (risk: $rk-leak, exposed: $ms-announce);
  $rk-calder isa risk, has code "RK-CALDER", has name "Calder withholds its licence consent", has description "Without Calder's consent, Atlas IP Holdings' core patent licence could be terminated on the change of control.", has likelihood "medium", has severity "high", has risk-status "closed", has mitigation "Early engagement with Calder. Consent received unconditionally on 9 October.";
  risk-ownership (risk-owner: $per-lindqvist, owned-risk: $rk-calder);
  risk-exposure (risk: $rk-calder, exposed: $cv-coc-calder);
